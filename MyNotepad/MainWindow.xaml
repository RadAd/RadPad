<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyNotepad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyNotepad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MyNotepad">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Loaded="RootGrid_Loaded"
          PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="StatusBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
            </Style>
            <Style x:Key="StatusBarSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip, drawn in the title bar area like Windows 11 Notepad. Each tab's editor lives in EditorHost below. -->
        <TabView x:Name="Tabs"
                 Grid.Row="0"
                 VerticalAlignment="Top"
                 TabWidthMode="Equal"
                 IsAddTabButtonVisible="True"
                 CanReorderTabs="True"
                 CanDragTabs="False"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged">
            <TabView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <Border Width="8" />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <!-- Draggable title bar region; MinWidth leaves room for the caption buttons. -->
                <Grid x:Name="TitleBarDragRegion" MinWidth="188" Background="Transparent" />
            </TabView.TabStripFooter>
        </TabView>

        <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <MenuBar x:Name="MainMenu" Grid.Row="0">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New tab" Tag="NewTab" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                            <KeyboardAccelerator Modifiers="Control" Key="T" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open..." Tag="Open" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save" Tag="Save" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save as..." Tag="SaveAs" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save all" Tag="SaveAll" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Menu" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Ctrl+W / Ctrl+F4 are handled in RootGrid_PreviewKeyDown so the TabView doesn't also act on them. -->
                    <MenuFlyoutItem Text="Close tab" Tag="CloseTab" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+W" />
                    <MenuFlyoutItem Text="Exit" Tag="Exit" Click="Command_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Edit">
                    <!-- The TextBox handles these shortcuts natively, so only the shortcut text is shown. -->
                    <MenuFlyoutItem Text="Undo" Tag="Undo" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+Z" />
                    <MenuFlyoutItem Text="Redo" Tag="Redo" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+Y" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Cut" Tag="Cut" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+X" />
                    <MenuFlyoutItem Text="Copy" Tag="Copy" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+C" />
                    <MenuFlyoutItem Text="Paste" Tag="Paste" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+V" />
                    <MenuFlyoutItem Text="Delete" Tag="Delete" Click="Command_Click" KeyboardAcceleratorTextOverride="Del" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Find" Tag="Find" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="F" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Find next" Tag="FindNext" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F3" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Find previous" Tag="FindPrevious" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Shift" Key="F3" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Replace" Tag="Replace" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="H" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Go to..." Tag="GoTo" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="G" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Select all" Tag="SelectAll" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+A" />
                    <MenuFlyoutItem Text="Time/Date" Tag="TimeDate" Click="Command_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <MenuBarItem Title="Format">
                    <ToggleMenuFlyoutItem x:Name="WordWrapItem" Text="Word wrap" Tag="WordWrap" Click="Command_Click" />
                    <MenuFlyoutItem Text="Font..." Tag="Font" Click="Command_Click" />
                </MenuBarItem>

                <MenuBarItem Title="View">
                    <MenuFlyoutSubItem Text="Zoom">
                        <!-- Accelerators for these are added in code (Ctrl+Plus/Minus need OEM key codes). -->
                        <MenuFlyoutItem x:Name="ZoomInItem" Text="Zoom in" Tag="ZoomIn" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+Plus" />
                        <MenuFlyoutItem x:Name="ZoomOutItem" Text="Zoom out" Tag="ZoomOut" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+Minus" />
                        <MenuFlyoutItem x:Name="ZoomResetItem" Text="Restore default zoom" Tag="ZoomReset" Click="Command_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem x:Name="StatusBarItem" Text="Status bar" Tag="StatusBar" Click="Command_Click" IsChecked="True" />
                </MenuBarItem>

                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About MyNotepad" Tag="About" Click="Command_Click" />
                </MenuBarItem>
            </MenuBar>

            <!-- Find / replace panel -->
            <StackPanel x:Name="FindPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Padding="12,8"
                        Spacing="8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" PlaceholderText="Find" KeyDown="FindBox_KeyDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Tag="FindPrevious" Click="Command_Click" ToolTipService.ToolTip="Find previous (Shift+F3)">
                            <FontIcon Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button Tag="FindNext" Click="Command_Click" ToolTipService.ToolTip="Find next (F3)">
                            <FontIcon Glyph="&#xE74B;" FontSize="14" />
                        </Button>
                        <CheckBox x:Name="MatchCaseCheck" Content="Match case" MinWidth="0" Margin="12,0,0,0" />
                        <CheckBox x:Name="WrapAroundCheck" Content="Wrap around" MinWidth="0" IsChecked="True" />
                        <Button Tag="CloseFind" Click="Command_Click" ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ReplaceRow" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplaceBox" PlaceholderText="Replace with" KeyDown="ReplaceBox_KeyDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Content="Replace" Tag="ReplaceOne" Click="Command_Click" />
                        <Button Content="Replace all" Tag="ReplaceAll" Click="Command_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- One TextBox per tab is added here from code; only the selected tab's editor is visible. -->
            <Grid x:Name="EditorHost" Grid.Row="2">
                <Grid.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </Grid.Resources>
            </Grid>

            <!-- Status bar -->
            <Grid x:Name="StatusBar"
                  Grid.Row="3"
                  Height="30"
                  Padding="8,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageText" Style="{StaticResource StatusBarTextStyle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="CaretPositionText" Style="{StaticResource StatusBarTextStyle}" MinWidth="110" Text="Ln 1, Col 1" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock x:Name="CharacterCountText" Style="{StaticResource StatusBarTextStyle}" MinWidth="90" Text="0 characters" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock x:Name="ZoomText" Style="{StaticResource StatusBarTextStyle}" MinWidth="40" Text="100%" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Button x:Name="LineEndingButton" Style="{StaticResource StatusBarButtonStyle}" Content="Windows (CRLF)" ToolTipService.ToolTip="Line endings">
                        <Button.Flyout>
                            <MenuFlyout x:Name="LineEndingFlyout">
                                <RadioMenuFlyoutItem Text="Windows (CRLF)" Tag="0" GroupName="LineEnding" Click="LineEnding_Click" />
                                <RadioMenuFlyoutItem Text="Unix (LF)" Tag="1" GroupName="LineEnding" Click="LineEnding_Click" />
                                <RadioMenuFlyoutItem Text="Macintosh (CR)" Tag="2" GroupName="LineEnding" Click="LineEnding_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Button x:Name="EncodingButton" Style="{StaticResource StatusBarButtonStyle}" Content="UTF-8" ToolTipService.ToolTip="Encoding">
                        <Button.Flyout>
                            <MenuFlyout x:Name="EncodingFlyout">
                                <RadioMenuFlyoutItem Text="UTF-8" Tag="0" GroupName="Encoding" Click="Encoding_Click" />
                                <RadioMenuFlyoutItem Text="UTF-8 with BOM" Tag="1" GroupName="Encoding" Click="Encoding_Click" />
                                <RadioMenuFlyoutItem Text="UTF-16 LE" Tag="2" GroupName="Encoding" Click="Encoding_Click" />
                                <RadioMenuFlyoutItem Text="UTF-16 BE" Tag="3" GroupName="Encoding" Click="Encoding_Click" />
                                <RadioMenuFlyoutItem Text="ANSI" Tag="4" GroupName="Encoding" Click="Encoding_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
