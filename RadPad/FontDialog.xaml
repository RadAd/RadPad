<?xml version="1.0" encoding="utf-8"?>
<!-- Format > Font: the editor font, with a preview. -->
<ContentDialog
    x:Class="RadPad.FontDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Font"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="320">
        <!-- Items are added in code: the system's fonts. -->
        <ComboBox x:Name="FamilyBox" Header="Font" HorizontalAlignment="Stretch" SelectionChanged="Font_Changed" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- In this order: bit 1 is bold, bit 0 italic. -->
            <ComboBox x:Name="StyleBox" Header="Style" Width="160" SelectionChanged="Font_Changed">
                <x:String>Regular</x:String>
                <x:String>Italic</x:String>
                <x:String>Bold</x:String>
                <x:String>Bold Italic</x:String>
            </ComboBox>
            <ComboBox x:Name="SizeBox" Header="Size" Width="110" IsEditable="True" SelectionChanged="Font_Changed">
                <x:String>8</x:String>
                <x:String>9</x:String>
                <x:String>10</x:String>
                <x:String>11</x:String>
                <x:String>12</x:String>
                <x:String>14</x:String>
                <x:String>16</x:String>
                <x:String>18</x:String>
                <x:String>20</x:String>
                <x:String>22</x:String>
                <x:String>24</x:String>
                <x:String>26</x:String>
                <x:String>28</x:String>
                <x:String>36</x:String>
                <x:String>48</x:String>
                <x:String>72</x:String>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="Preview" Text="AaBbYyZz 0123456789" Height="64" Margin="0,8,0,0" />
    </StackPanel>
</ContentDialog>
