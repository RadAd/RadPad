<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RadPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RadPad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RadPad">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Loaded="RootGrid_Loaded"
          PreviewKeyDown="RootGrid_PreviewKeyDown"
          PreviewKeyUp="RootGrid_PreviewKeyUp">
        <Grid.Resources>
            <Style x:Key="StatusBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
            </Style>
            <Style x:Key="StatusBarSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- Right-click menu shared by all tabs. Items act on the tab that was right-clicked. -->
            <MenuFlyout x:Key="TabMenu" Opening="TabMenu_Opening">
                <MenuFlyoutItem Text="Copy file name" x:Name="TabCopyNameItem" Click="TabCopyName_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy full path" x:Name="TabCopyPathItem" Click="TabCopyPath_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open containing folder" x:Name="TabOpenFolderItem" Click="TabOpenFolder_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close" x:Name="TabCloseItem" Click="TabClose_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Close others" x:Name="TabCloseOthersItem" Click="TabCloseOthers_Click" />
                <MenuFlyoutItem Text="Close tabs to the right" x:Name="TabCloseRightItem" Click="TabCloseRight_Click" />
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip, drawn in the title bar area like Windows 11 Notepad. Each tab's editor lives in EditorHost below. -->
        <TabView x:Name="Tabs"
                 Grid.Row="0"
                 VerticalAlignment="Top"
                 TabWidthMode="Equal"
                 IsAddTabButtonVisible="True"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 AllowDrop="True"
                 TabDragStarting="Tabs_TabDragStarting"
                 TabDragCompleted="Tabs_TabDragCompleted"
                 TabDroppedOutside="Tabs_TabDroppedOutside"
                 TabStripDragOver="Tabs_TabStripDragOver"
                 TabStripDrop="Tabs_TabStripDrop"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged">
            <TabView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <Border Width="8" />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <!-- Draggable title bar region; MinWidth leaves room for the caption buttons. -->
                <Grid x:Name="TitleBarDragRegion" MinWidth="188" Background="Transparent" />
            </TabView.TabStripFooter>
        </TabView>

        <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <MenuBar x:Name="MainMenu" Grid.Row="0">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New tab" Click="NewTab_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                            <KeyboardAccelerator Modifiers="Control" Key="T" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open..." Click="Open_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open URL..." Click="OpenUrl_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save" Click="Save_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save as..." Click="SaveAs_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save all" Click="SaveAll_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78C;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Menu" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <!-- The file's read-only attribute; see UpdateReadOnly. -->
                    <ToggleMenuFlyoutItem x:Name="ReadOnlyItem" Text="Read-only" Click="ReadOnly_Click">
                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Items are added in code from the saved list. -->
                    <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="Recent files">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <!-- Ctrl+W / Ctrl+F4 are handled in RootGrid_PreviewKeyDown so the TabView doesn't also act on them. -->
                    <MenuFlyoutItem Text="Close tab" Click="CloseTab_Click" KeyboardAcceleratorTextOverride="Ctrl+W">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Edit">
                    <!-- The editor handles these shortcuts natively, so only the shortcut text is shown. -->
                    <MenuFlyoutItem Text="Undo" Click="Undo_Click" KeyboardAcceleratorTextOverride="Ctrl+Z">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Redo" Click="Redo_Click" KeyboardAcceleratorTextOverride="Ctrl+Y">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Cut" Click="Cut_Click" KeyboardAcceleratorTextOverride="Ctrl+X">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copy" Click="Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Paste" Click="Paste_Click" KeyboardAcceleratorTextOverride="Ctrl+V">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete" Click="Delete_Click" KeyboardAcceleratorTextOverride="Del">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Find" Click="Find_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="F" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Find next" Click="FindNext_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F3" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Find previous" Click="FindPrevious_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Shift" Key="F3" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Replace" Click="Replace_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="H" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Go to..." Click="GoTo_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AD;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="G" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <!-- Ctrl+] (and Ctrl+Shift+] to select) are handled in the editor's key handler. -->
                    <MenuFlyoutItem Text="Go to matching bracket" Click="MatchingBracket_Click" KeyboardAcceleratorTextOverride="Ctrl+]">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Select all" Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Time/Date" Click="TimeDate_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <MenuBarItem Title="Format">
                    <ToggleMenuFlyoutItem x:Name="WordWrapItem" Text="Word wrap" Click="WordWrap_Click">
                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE751;" /></ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutItem Text="Font..." Click="Font_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <!-- Items are added in code, one per language. -->
                    <MenuFlyoutSubItem x:Name="LanguageMenu" Text="Language">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8C1;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <!-- Tab key behaviour and tab width; items are added in code. -->
                    <MenuFlyoutSubItem x:Name="TabsMenu" Text="Tabs">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A0;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                </MenuBarItem>

                <MenuBarItem Title="View">
                    <MenuFlyoutSubItem Text="Zoom">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE71E;" /></MenuFlyoutSubItem.Icon>
                        <!-- Accelerators for these are added in code (Ctrl+Plus/Minus need OEM key codes). -->
                        <MenuFlyoutItem x:Name="ZoomInItem" Text="Zoom in" Click="ZoomIn_Click" KeyboardAcceleratorTextOverride="Ctrl+Plus">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ZoomOutItem" Text="Zoom out" Click="ZoomOut_Click" KeyboardAcceleratorTextOverride="Ctrl+Minus">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ZoomResetItem" Text="Restore default zoom" Click="ZoomReset_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem x:Name="StatusBarItem" Text="Status bar" Click="StatusBar_Click" IsChecked="True" />
                    <ToggleMenuFlyoutItem x:Name="OutputPanelItem" Text="Output panel" Click="OutputPanel_Click" />
                    <!-- Only available with a monospaced font and word wrap off; see UpdateWhitespaceAvailability. -->
                    <ToggleMenuFlyoutItem x:Name="ShowWhitespaceItem" Text="Show whitespace" Click="ShowWhitespace_Click" />
                    <ToggleMenuFlyoutItem x:Name="TrailingWhitespaceItem" Text="Highlight trailing whitespace" Click="TrailingWhitespace_Click" />
                    <ToggleMenuFlyoutItem x:Name="RainbowBracketsItem" Text="Rainbow brackets" Click="RainbowBrackets_Click">
                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <!-- Items are added in code, one per loaded theme. -->
                    <MenuFlyoutSubItem x:Name="ColorThemeMenu" Text="Color theme">
                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                </MenuBarItem>

                <!-- Items are added in code from the user's tools file (Tools > Edit tools). -->
                <MenuBarItem x:Name="ToolsMenu" Title="Tools" />

                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About RadPad" Click="About_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>

            <!-- Find / replace panel -->
            <StackPanel x:Name="FindPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Padding="12,8"
                        Spacing="8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" PlaceholderText="Find" KeyDown="FindBox_KeyDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Click="FindPrevious_Click" ToolTipService.ToolTip="Find previous (Shift+F3)" AutomationProperties.Name="Find previous">
                            <FontIcon Glyph="&#xE74A;" FontSize="14" />
                        </Button>
                        <Button Click="FindNext_Click" ToolTipService.ToolTip="Find next (F3)" AutomationProperties.Name="Find next">
                            <FontIcon Glyph="&#xE74B;" FontSize="14" />
                        </Button>
                        <CheckBox x:Name="MatchCaseCheck" Content="Match case" MinWidth="0" Margin="12,0,0,0" />
                        <CheckBox x:Name="RegexCheck" Content="Regular expression" MinWidth="0"
                                  ToolTipService.ToolTip="JavaScript-style patterns. ^ and $ match at line starts and ends, \n matches a line break. In the replacement, $1 inserts a group and \n a line break." />
                        <CheckBox x:Name="WrapAroundCheck" Content="Wrap around" MinWidth="0" IsChecked="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="CloseFind_Click" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close find">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
                <Grid x:Name="ReplaceRow" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplaceBox" PlaceholderText="Replace with" KeyDown="ReplaceBox_KeyDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Content="Replace" Click="ReplaceOne_Click" />
                        <Button Content="Replace all" Click="ReplaceAll_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- One editor per tab is added here from code; only the selected tab's editor is visible. -->
            <Grid x:Name="EditorHost" Grid.Row="2">
                <Grid.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </Grid.Resources>
                <!-- Draws over the current editor: space and tab markers (View > Show whitespace), or wrapped-line markers when word wrap is on. -->
                <Canvas x:Name="EditorOverlay" IsHitTestVisible="False" Canvas.ZIndex="1" />
            </Grid>

            <!-- Output panel for tools run with "output": "panel" (Tools menu), resized by dragging the bar above it
                 or the panel's heading. Both show the resize pointer, set in code. -->
            <Border x:Name="OutputSplitter"
                    Grid.Row="3"
                    Height="8"
                    Visibility="Collapsed"
                    Background="Transparent"
                    PointerPressed="OutputSplitter_PointerPressed"
                    PointerMoved="OutputSplitter_PointerMoved"
                    PointerReleased="OutputSplitter_PointerReleased"
                    PointerCaptureLost="OutputSplitter_PointerCaptureLost">
                <Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Border x:Name="OutputSplitterHighlight" Height="3" VerticalAlignment="Bottom" Opacity="0"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
            </Border>
            <Grid x:Name="OutputPanel" Grid.Row="4" Height="200" Visibility="Collapsed">
                <Grid.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="OutputHeader"
                      Padding="12,2,4,2"
                      ColumnSpacing="8"
                      Background="Transparent"
                      PointerPressed="OutputSplitter_PointerPressed"
                      PointerMoved="OutputSplitter_PointerMoved"
                      PointerReleased="OutputSplitter_PointerReleased"
                      PointerCaptureLost="OutputSplitter_PointerCaptureLost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="OutputStatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="OutputStopButton" Click="OutputStop_Click" IsEnabled="False" Style="{StaticResource StatusBarButtonStyle}"
                                ToolTipService.ToolTip="Stop the tool" AutomationProperties.Name="Stop">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        </Button>
                        <Button Click="OutputClear_Click" Style="{StaticResource StatusBarButtonStyle}"
                                ToolTipService.ToolTip="Clear output" AutomationProperties.Name="Clear output">
                            <FontIcon Glyph="&#xE75C;" FontSize="14" />
                        </Button>
                        <Button Click="OutputClose_Click" Style="{StaticResource StatusBarButtonStyle}"
                                ToolTipService.ToolTip="Close the panel (the tool keeps running)" AutomationProperties.Name="Close output">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Double-clicking a line that names a file and line, or pressing Enter on it, opens it there
                     (handlers added in code, as the box handles those events itself). -->
                <RichEditBox x:Name="OutputBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False"
                             TextWrapping="NoWrap"
                             BorderThickness="0"
                             Padding="12,4,12,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Tool output" />
            </Grid>

            <!-- Status bar -->
            <Grid x:Name="StatusBar"
                  Grid.Row="5"
                  Height="30"
                  Padding="8,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageText" Style="{StaticResource StatusBarTextStyle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="CaretPositionText" Style="{StaticResource StatusBarTextStyle}" MinWidth="110" Text="Ln 1, Col 1" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock x:Name="CharacterCountText" Style="{StaticResource StatusBarTextStyle}" MinWidth="90" Text="0 characters" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock x:Name="ZoomText" Style="{StaticResource StatusBarTextStyle}" MinWidth="40" Text="100%" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Button x:Name="IndentButton" Style="{StaticResource StatusBarButtonStyle}" Content="Tab width: 8" ToolTipService.ToolTip="Tabs and indentation">
                        <Button.Flyout>
                            <!-- Items are added in code. -->
                            <MenuFlyout x:Name="IndentFlyout" />
                        </Button.Flyout>
                    </Button>
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Button x:Name="LanguageButton" Style="{StaticResource StatusBarButtonStyle}" Content="Plain text" ToolTipService.ToolTip="Language">
                        <Button.Flyout>
                            <!-- Items are added in code, one per language. -->
                            <MenuFlyout x:Name="LanguageFlyout" />
                        </Button.Flyout>
                    </Button>
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Button x:Name="LineEndingButton" Style="{StaticResource StatusBarButtonStyle}" Content="Windows (CRLF)" ToolTipService.ToolTip="Line endings">
                        <Button.Flyout>
                            <MenuFlyout x:Name="LineEndingFlyout">
                                <RadioMenuFlyoutItem x:Name="CrlfItem" Text="Windows (CRLF)" GroupName="LineEnding" Click="Crlf_Click" />
                                <RadioMenuFlyoutItem x:Name="LfItem" Text="Unix (LF)" GroupName="LineEnding" Click="Lf_Click" />
                                <RadioMenuFlyoutItem x:Name="CrItem" Text="Macintosh (CR)" GroupName="LineEnding" Click="Cr_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Button x:Name="EncodingButton" Style="{StaticResource StatusBarButtonStyle}" Content="UTF-8" ToolTipService.ToolTip="Encoding">
                        <Button.Flyout>
                            <MenuFlyout x:Name="EncodingFlyout">
                                <RadioMenuFlyoutItem x:Name="Utf8Item" Text="UTF-8" GroupName="Encoding" Click="Utf8_Click" />
                                <RadioMenuFlyoutItem x:Name="Utf8BomItem" Text="UTF-8 with BOM" GroupName="Encoding" Click="Utf8Bom_Click" />
                                <RadioMenuFlyoutItem x:Name="Utf16LEItem" Text="UTF-16 LE" GroupName="Encoding" Click="Utf16LE_Click" />
                                <RadioMenuFlyoutItem x:Name="Utf16BEItem" Text="UTF-16 BE" GroupName="Encoding" Click="Utf16BE_Click" />
                                <RadioMenuFlyoutItem x:Name="AnsiItem" Text="ANSI" GroupName="Encoding" Click="Ansi_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
