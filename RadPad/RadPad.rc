// Win32 resources. The first icon is the one Explorer and the taskbar show for RadPad.exe.
// RadPad.ico is generated by tools/MakeIcon.ps1.

#include <winver.h>
#include "Version.h"

1 ICON "RadPad.ico"

// Shown in Explorer under Properties > Details. The version comes from Version.h.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION RADPAD_VERSION_MAJOR, RADPAD_VERSION_MINOR, RADPAD_VERSION_PATCH, 0
 PRODUCTVERSION RADPAD_VERSION_MAJOR, RADPAD_VERSION_MINOR, RADPAD_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RadPad"
            VALUE "FileVersion", RADPAD_VERSION_STRING
            VALUE "InternalName", "RadPad"
            VALUE "OriginalFilename", "RadPad.exe"
            VALUE "ProductName", "RadPad"
            VALUE "ProductVersion", RADPAD_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
